    {
      "name": "text to video goes to the Hunyuan video endpoint with 5s 720p",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "requestBody": {
            "prompt": "A puppy runs on grass",
            "seed": 7,
            "duration": 5,
            "aspect_ratio": "9:16",
            "model": "hy-video-v1.5"
          },
          "requestHeaders": {
            "Content-Type": "application/json",
            "Accept": ""
          },
          "action": "text_to_video",
          "model": "hy-video-v1.5",
          "upstreamModel": "hy-video-v1.5",
          "baseUrl": "https://tokenhub.tencentmaas.com",
          "apiKey": "test-key",
          "authHeader": "Bearer test-key",
          "upstream": {
            "kind": "vendor"
          },
          "config": {},
          "files": [],
          "publicTaskId": "task_public"
        }
      ],
      "expected": {
        "url": "https://tokenhub.tencentmaas.com/v1/wand/hunyuan-video/generation",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json",
          "Authorization": "Bearer test-key"
        },
        "body": {
          "model": "hy-video-v1.5",
          "prompt": "A puppy runs on grass",
          "aspect_ratio": "9:16",
          "seed": 7,
          "duration": 5,
          "resolution": "720p"
        },
        "action": "text_to_video"
      }
    },
